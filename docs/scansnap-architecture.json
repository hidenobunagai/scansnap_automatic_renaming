  "cards": [
    {
      "dot": "cyan",
      "title": "Ingestion & Trigger",
      "items": [
        "ScanSnap scans paper directly to Google Drive inbox folder",
        "Apps Script time-driven trigger runs batch job every 15 minutes",
        "Filters unstable files (< FILE_STABLE_MINUTES) to prevent partial reads"
      ]
    },
    {
      "dot": "emerald",
      "title": "OCR & AI Renaming",
      "items": [
        "Google Drive native OCR converts PDF pages into raw text without external OCR services",
        "Gemini or OpenAI parses structured fields: document date, issuer, type, and subject",
        "Normalizes issuer names to half-width alphanumeric and resolves weak issuer fallbacks"
      ]
    },
    {
      "dot": "violet",
      "title": "Archive & Audit Log",
      "items": [
        "Organizes files into [Issuer]/[DocumentType] folder structure in family shared drive",
        "Avoids duplicate filenames with _2, _3 suffixes and logs full execution history to Sheets",
        "Sends failure alert emails on OCR/copy errors, supporting review dry-run and rename modes"
      ]
    }
  ]
