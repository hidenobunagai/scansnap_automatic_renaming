{
  "name": "scansnap-automatic-renaming",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck -p jsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "format": "prettier --write src scripts tests package.json",
    "format:check": "prettier --check src scripts tests package.json",
    "env:init": "node scripts/init-local-env.mjs",
    "clasp:configure": "npx -y @dotenvx/dotenvx run -- node scripts/write-clasp-config.mjs",
    "clasp:push": "bun run clasp:configure && npx -y @google/clasp push",
    "clasp:pull": "bun run clasp:configure && npx -y @google/clasp pull",
    "clasp:open": "bun run clasp:configure && npx -y @google/clasp open",
    "setup:remote": "npx -y @dotenvx/dotenvx run -- node scripts/bootstrap-remote-setup.mjs"
  },
  "devDependencies": {
    "eslint": "9",
    "prettier": "^3.9.6",
    "typescript": "5"
  }
}
