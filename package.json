{
  "name": "scansnap-automatic-renaming",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "find src scripts -type f \\( -name \"*.js\" -o -name \"*.mjs\" \\) -exec node --check {} \\;",
    "typecheck": "tsc --noEmit --skipLibCheck -p jsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "format": "prettier --write src scripts tests package.json",
    "format:check": "prettier --check src scripts tests package.json",
    "env:init": "node scripts/init-local-env.mjs",
    "clasp:configure": "dotenvx run -- node scripts/write-clasp-config.mjs",
    "clasp:push": "bun run clasp:configure && clasp push",
    "clasp:pull": "bun run clasp:configure && clasp pull",
    "clasp:open": "bun run clasp:configure && clasp open",
    "setup:remote": "dotenvx run -- node scripts/bootstrap-remote-setup.mjs"
  },
  "devDependencies": {
    "eslint": "9",
    "prettier": "^3.9.6",
    "typescript": "7"
  }
}
