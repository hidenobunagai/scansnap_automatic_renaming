# Copy to .env and fill with `dotenvx set KEY value` (values are encrypted)
# Required for clasp
CLASP_SCRIPT_ID=
CLASP_PROJECT_ID=
# Required for remote setup
SCANSNAP_FOLDER_ID=
ARCHIVE_ROOT_FOLDER_ID=
# Alternative: ARCHIVE_ROOT_FOLDER_URL=https://drive.google.com/drive/folders/...
# AI provider
AI_PROVIDER=gemini
GEMINI_API_KEY=
# For openai provider:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gemini-2.5-flash-lite
RENAME_MODE=review
MIN_CONFIDENCE=0.75
MAX_FILES_PER_RUN=5
FILE_STABLE_MINUTES=5
OCR_LANGUAGE=ja
TRIGGER_MINUTES=15
TIMEZONE=Asia/Tokyo
FILENAME_PATTERN_HINT=YYYY-MM-DD_発行元_書類種別_要点
USER_WEAK_ISSUER_LABELS=
LOG_SPREADSHEET_ID=
LOG_SHEET_NAME=scan_rename_log
MAX_PROMPT_CHARS=12000
MAX_SUBJECT_LENGTH=40
MAX_ISSUER_LENGTH=30
MAX_DOCUMENT_TYPE_LENGTH=30
NOTIFICATION_EMAIL=
